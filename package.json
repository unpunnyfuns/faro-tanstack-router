{
  "name": "@unpunnyfuns/faro-tanstack-router",
  "version": "1.0.1",
  "description": "Grafana Faro instrumentation for TanStack Router",
  "license": "MIT",
  "author": "unpunnyfuns",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unpunnyfuns/faro-tanstack-router.git"
  },
  "homepage": "https://github.com/unpunnyfuns/faro-tanstack-router#readme",
  "bugs": {
    "url": "https://github.com/unpunnyfuns/faro-tanstack-router/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "faro",
    "grafana",
    "tanstack",
    "router",
    "rum",
    "observability"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack .",
    "sync-version": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@grafana/faro-web-sdk": "^2.9.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-core": "^1.171.15",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semantic-release": "^25.0.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@grafana/faro-web-sdk": "^2.9.0",
    "@tanstack/router-core": "^1.171.15"
  }
}
